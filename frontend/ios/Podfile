# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Firebase pods are written in Swift and depend on GoogleUtilities, which
# does not define clang modules. Enable modular headers so they can be built
# as static libraries.
use_modular_headers!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'StreakFightNew' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end

    # Workaround for "Multiple commands produce .../PrivacyInfo.xcprivacy"
    # (RN 0.85.x + Xcode 26). Deduplicate PrivacyInfo.xcprivacy within each
    # target's Resources build phase so only one copy command remains.
    installer.pods_project.targets.each do |target|
      target.build_phases.each do |build_phase|
        next unless build_phase.is_a?(Xcodeproj::Project::Object::PBXResourcesBuildPhase)
        seen = false
        build_phase.files.dup.each do |build_file|
          name = build_file.display_name rescue nil
          next unless name == 'PrivacyInfo.xcprivacy'
          if seen
            build_phase.remove_build_file(build_file)
          else
            seen = true
          end
        end
      end
    end
  end
end
