# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
dist/
build/

# Environment / secrets (never commit real credentials)
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# Firebase credentials
backend/firebase-service-account.json
frontend/android/app/google-services.json
frontend/ios/GoogleService-Info.plist

# React Native
frontend/node_modules/
frontend/.gradle/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/app/debug/
frontend/android/app/release/
frontend/ios/build/
frontend/ios/Pods/
frontend/**/*.jks
frontend/**/*.p8
frontend/**/*.p12
frontend/**/*.mobileprovision
frontend/**/*.orig.*

# Claude Code agent worktrees
.claude/worktrees/

# Xcode
frontend/ios/*.xcworkspace/xcuserdata/
frontend/ios/*.xcodeproj/xcuserdata/
frontend/ios/DerivedData/
frontend/ios/**/*.hmap

# General
.DS_Store
Thumbs.db
*.log
*.orig
